{
  "name": "session-handoff",
  "version": "0.6.1",
  "description": "Create handoffs and migrate sessions between Claude Code and Codex.",
  "license": "MIT",
  "bin": {
    "session-handoff": "bin/session-handoff"
  },
  "scripts": {
    "preinstall": "python3 -c \"import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)\" || { echo \"session-handoff requires Python 3.10+ (python3) on PATH.\" >&2; exit 1; }",
    "postinstall": "python3 bin/session-handoff _telemetry-postinstall || true"
  },
  "files": [
    "bin/session-handoff",
    "commands/",
    "server/*.py",
    "skills/session-handoff/SKILL.md",
    ".claude-plugin/",
    ".codex-plugin/",
    ".mcp.json",
    "mcp.json",
    "plugin.json",
    "README.md",
    "hooks/hooks.json",
    "hooks/session-start.py",
    "hooks/user-prompt-submit.py",
    "docs/telemetry.md"
  ],
  "engines": {
    "node": ">=18",
    "python": ">=3.10"
  },
  "os": [
    "linux",
    "darwin"
  ]
}
