{
  "description": "One-time anonymous telemetry opt-in reminder.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/session-start.py\"",
            "timeout": 5,
            "statusMessage": "Checking telemetry status"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/server/checkpoint.py\"",
            "timeout": 5,
            "statusMessage": "Saving session checkpoint"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/user-prompt-submit.py\"",
            "timeout": 1,
            "statusMessage": "Checking telemetry response"
          }
        ]
      }
    ]
  }
}
