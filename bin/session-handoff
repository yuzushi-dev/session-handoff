#!/usr/bin/env python3
"""Launch Codex or Claude with automatic session handoff support."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

PACKAGE_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PACKAGE_ROOT))

from server.session_switch import SessionSupervisor
from server.setup import SetupError, install_setup, render_plan, restore_setup, setup_plan
from server.command_matrix import main as doctor_main
import server.telemetry as telemetry


def _home() -> Path:
    return Path(os.environ.get("SESSION_HANDOFF_HOME", str(Path.home()))).expanduser()


def _telemetry(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="session-handoff telemetry")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("status")
    commands.add_parser("enable")
    commands.add_parser("preview")
    commands.add_parser("flush")
    report = commands.add_parser("report")
    report.add_argument("--category", choices=sorted(telemetry.FEEDBACK_CATEGORIES), required=True)
    report.add_argument("--severity", choices=sorted(telemetry.FEEDBACK_SEVERITIES), required=True)
    detached = commands.add_parser("_detached-flush")
    detached.add_argument("--queue-path", required=True)
    detached.add_argument("--config-path", required=True)
    disable = commands.add_parser("disable")
    disable.add_argument("--purge", action="store_true")
    args = parser.parse_args(argv)
    if args.command == "_detached-flush":
        return telemetry.detached_flush(args.queue_path, args.config_path)
    home = _home()
    try:
        config = None if args.command == "disable" and args.purge else telemetry.load_config(home)
        if telemetry.do_not_track_enabled() and args.command in {"status", "enable", "flush"}:
            if args.command == "status":
                print("Telemetry: disabled by DO_NOT_TRACK.")
            elif args.command == "enable":
                print("Telemetry is disabled by DO_NOT_TRACK.")
            else:
                print("Telemetry flush skipped because DO_NOT_TRACK is set.")
            return 0
        if args.command == "status":
            if config is None or not config["enabled"]:
                print("Telemetry: disabled.")
            else:
                print("Telemetry: enabled.")
                error = telemetry.last_flush_error(home)
                if error:
                    status = f" (status {error['status']})" if error.get("status") else ""
                    print(f"Last flush failed at {error['at']}: {error['error']}{status}")
            return 0
        if args.command == "enable":
            if config is not None and config["enabled"]:
                print("Telemetry is already enabled.")
                return 0
            if telemetry.consent_state(config) == "declined":
                print("Telemetry consent was declined and cannot be requested again.")
                return 0
            if telemetry.consent_state(config) == "asked":
                print(
                    "Telemetry consent is pending; reply exactly "
                    "`session-handoff telemetry yes` or `session-handoff telemetry no`."
                )
                return 0
            if not sys.stdin.isatty():
                print("Telemetry enable requires an interactive terminal.", file=sys.stderr)
                return 2
            telemetry.request_consent(home, interactive=True, input_fn=input)
            print("Telemetry consent recorded.")
            return 0
        if args.command == "preview":
            rows = telemetry.load_batch(home)
            if not rows:
                print("Telemetry queue is empty.")
                return 0
            if config is None or not config["enabled"]:
                print("Telemetry is disabled; no upload request.")
                return 0
            endpoint = config["endpoint"]
            request = telemetry.build_request(endpoint, rows)
            print("Headers: " + ", ".join(sorted(request.headers)))
            print("Body (hex): " + request.data.hex())
            print(json.dumps(telemetry.to_otlp_logs(rows), sort_keys=True, separators=(",", ":")))
            print("Idempotency-Key: " + request.headers["Idempotency-key"])
            return 0
        if args.command == "flush":
            telemetry.spawn_detached_flush(
                home / telemetry.STATE_PATH / telemetry._QUEUE_NAME,
                telemetry.config_path(home),
            )
            print("Telemetry flush started.")
            return 0
        if args.command == "report":
            event = telemetry.record_context_feedback(args.category, args.severity, home=home)
            print(json.dumps(event, sort_keys=True, separators=(",", ":")))
            return 0
        telemetry.disable(home, purge=args.purge)
        print("Telemetry disabled." if not args.purge else "Telemetry disabled and local data purged.")
        return 0
    except telemetry.TelemetryConfigError as exc:
        print(f"Telemetry configuration error: {exc}", file=sys.stderr)
        return 1
    except OSError as exc:
        print(f"Telemetry operation failed: {exc}", file=sys.stderr)
        return 1


def _telemetry_postinstall() -> int:
    """npm postinstall hook: one-time, local-only consent prompt.

    Never fails or hangs `npm install`: every path returns 0, every error is
    swallowed. No network call happens here -- upload only ever happens
    later, if enabled, from the product's own telemetry paths.
    """
    if os.environ.get("SESSION_HANDOFF_SKIP_TELEMETRY_PROMPT"):
        return 0
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return 0  # CI, --ignore-scripts consumers, piped installs, etc.
    home = _home()
    try:
        if telemetry.load_config(home) is not None:
            return 0  # already prompted at least once; never re-ask on reinstall/upgrade
        result = telemetry.request_consent(home, interactive=True, input_fn=input)
        print("telemetry enabled." if result["enabled"] else "telemetry not enabled.")
    except Exception:
        pass
    return 0


def _setup(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="session-handoff setup",
        description="Install the user-scoped Codex and Claude handoff adapters.",
    )
    parser.add_argument(
        "--client",
        action="append",
        choices=("codex", "claude"),
        help="Only configure one client; repeat to configure both.",
    )
    parser.add_argument("-y", "--yes", action="store_true", help="Skip the confirmation prompt.")
    args = parser.parse_args(argv)

    requested = args.client or ["codex", "claude"]
    executable_paths: dict[str, Path] = {}
    missing: list[str] = []
    for client in dict.fromkeys(requested):
        executable = shutil.which(client)
        if executable:
            executable_paths[client] = Path(executable)
        else:
            missing.append(client)
    if missing and args.client:
        print("client executable not found: " + ", ".join(missing), file=sys.stderr)
        return 2
    if not executable_paths:
        print("No supported client executable found (codex or claude).", file=sys.stderr)
        return 2

    home = _home()
    try:
        telemetry_config = telemetry.load_config(home)
    except telemetry.TelemetryConfigError as exc:
        print(f"Setup failed: {exc}", file=sys.stderr)
        return 1
    package_root = PACKAGE_ROOT
    plan = setup_plan(package_root, home, list(executable_paths), executable_paths=executable_paths)
    print(render_plan(plan))
    if not args.yes:
        if not sys.stdin.isatty():
            print("Setup requires an interactive terminal.", file=sys.stderr)
            return 2
        try:
            answer = input("\nProceed with this setup? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("Setup cancelled.")
            return 0
        if answer not in {"y", "yes"}:
            print("Setup cancelled.")
            return 0

    try:
        result = install_setup(
            package_root,
            home,
            list(executable_paths),
            executable_paths=executable_paths,
        )
    except (SetupError, OSError, subprocess.CalledProcessError) as exc:
        print(f"Setup failed: {exc}", file=sys.stderr)
        return 1
    print("\nSetup complete. Restart the client and any open shell once.")
    if telemetry_config is None and not result.get("already_configured") and not args.yes and sys.stdin.isatty():
        try:
            telemetry.request_consent(home, interactive=True, input_fn=input)
        except (telemetry.TelemetryConfigError, OSError) as exc:
            print(f"Telemetry setup failed: {exc}", file=sys.stderr)
            return 1
    if missing:
        print("Skipped unavailable client(s): " + ", ".join(missing))
    if result.get("already_configured"):
        print("Existing setup reconciled with the current package.")
    return 0


def _run_supervisor(argv: list[str]) -> int:
    if len(argv) < 3 or argv[0] not in {"codex", "claude"} or argv[1] != "--executable":
        raise SystemExit("usage: session-handoff run {codex|claude} --executable PATH [HOST_ARGS...]")
    client = argv[0]
    executable = argv[2]
    host_args = argv[3:]
    return SessionSupervisor(
        client,
        host_args,
        executable=executable,
    ).run()


def _uninstall(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        prog="session-handoff uninstall",
        description="Restore client launchers and remove the managed setup.",
    )
    parser.add_argument("-y", "--yes", action="store_true", help="Skip the confirmation prompt.")
    args = parser.parse_args(argv)
    home = _home()
    if not args.yes:
        try:
            answer = input("Restore original launchers and remove session-handoff setup? [y/N] ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("Uninstall cancelled.")
            return 0
        if answer not in {"y", "yes"}:
            print("Uninstall cancelled.")
            return 0
    try:
        result = restore_setup(home)
    except (SetupError, OSError, subprocess.CalledProcessError) as exc:
        print(f"Uninstall failed: {exc}", file=sys.stderr)
        return 1
    if result.get("already_clean"):
        print("No managed setup found.")
    else:
        print("Session-handoff setup removed and original launchers restored.")
    return 0


def main() -> int:
    if sys.argv[1:2] == ["setup"]:
        return _setup(sys.argv[2:])
    if sys.argv[1:2] == ["run"]:
        return _run_supervisor(sys.argv[2:])
    if sys.argv[1:2] == ["uninstall"]:
        return _uninstall(sys.argv[2:])
    if sys.argv[1:2] == ["doctor"]:
        return doctor_main(sys.argv[2:])
    if sys.argv[1:2] == ["telemetry"]:
        return _telemetry(sys.argv[2:])
    if sys.argv[1:2] == ["_telemetry-postinstall"]:
        return _telemetry_postinstall()
    parser = argparse.ArgumentParser(
        description="Run Codex or Claude and automatically relaunch after a handoff."
    )
    parser.add_argument("client", choices=("codex", "claude"))
    parser.add_argument("host_args", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    host_args = args.host_args[1:] if args.host_args[:1] == ["--"] else args.host_args
    return SessionSupervisor(args.client, host_args).run()


if __name__ == "__main__":
    raise SystemExit(main())
