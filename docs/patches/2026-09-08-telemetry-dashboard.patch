diff --git a/tests/test_deploy.py b/tests/test_deploy.py
--- a/tests/test_deploy.py
+++ b/tests/test_deploy.py
@@ -150,6 +150,23 @@
         assert all("sum" in query and "count" in query for query in queries)
         assert all(f'service_name=\\"{service}\\"' in json.dumps(query) for query in queries)
         assert all(f"loki-{service}" in json.dumps(panel.get("datasource")) for panel in dashboard["panels"] if panel.get("targets"))
+
+
+def test_session_handoff_dashboard_uses_real_rows_and_bounded_active_days():
+    dashboard = json.loads((ROOT / "grafana-dashboard-session-handoff.json").read_text())
+    queries = [target["expr"] for panel in dashboard["panels"] for target in panel.get("targets", []) if "expr" in target]
+    assert all('origin="real"' in query for query in queries)
+    assert all('origin!="canary"' not in query for query in queries)
+
+    failures = next(panel for panel in dashboard["panels"] if panel["id"] == 4)
+    assert '| result=~"failure|fallback" |' in failures["targets"][0]["expr"]
+    assert 'failure_stage="none"' not in failures["targets"][0]["expr"]
+
+    active_days = next(panel for panel in dashboard["panels"] if panel["id"] == 7)
+    assert active_days["title"] == "Active environment-days by version"
+    assert '| event="active_day" |' in active_days["targets"][0]["expr"]
+    assert ") >= 5" in active_days["targets"][0]["expr"]
+    assert "installation" not in active_days.get("description", "").lower()


